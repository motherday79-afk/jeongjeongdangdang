{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "api/rank/current.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/person-photo.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/gateway.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' https: data: blob:; connect-src 'self'; font-src 'self' data:; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests",
        "Strict-Transport-Security": "max-age=31536000",
        "X-Permitted-Cross-Domain-Policies": "none"
      },
      "continue": true
    },
    {
      "src": "/",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/index.html",
      "headers": {
        "Cache-Control": "no-store, max-age=0, must-revalidate"
      },
      "continue": true
    },
    {
      "src": "/admin",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      },
      "continue": true
    },
    {
      "src": "/admin.html",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      },
      "continue": true
    },
    {
      "src": "/api/admin/(.*)",
      "headers": {
        "Cache-Control": "no-store, max-age=0"
      },
      "continue": true
    },
    {
      "src": "/api/account/(.*)",
      "headers": {
        "Cache-Control": "private, no-store, max-age=0"
      },
      "continue": true
    },
    {
      "src": "/api/referrals",
      "headers": {
        "Cache-Control": "private, no-store, max-age=0"
      },
      "continue": true
    },
    {
      "src": "/api/badges",
      "headers": {
        "Cache-Control": "private, no-store, max-age=0"
      },
      "continue": true
    },
    {
      "src": "/api/rank/current",
      "dest": "/api/rank/current.js"
    },
    {
      "src": "/api/person-photo",
      "dest": "/api/person-photo.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/gateway.js?__path=$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/admin",
      "dest": "/admin.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/finalize-visitors",
      "schedule": "0 15 * * *"
    }
  ]
}
